# Local development configuration.
# These defaults are intended for local/demo use only.

# OpenAI
# Required for clinical note embeddings and the Patient AI Assistant.
OPENAI_API_KEY=

# HAPI FHIR / pgvector PostgreSQL
PGVECTOR_DATABASE=hapi
PGVECTOR_USER=admin
PGVECTOR_PASSWORD=admin

# Airflow metadata PostgreSQL
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Airflow local authentication
AIRFLOW_JWT_SECRET=healthcare-ai-local-jwt-secret
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow